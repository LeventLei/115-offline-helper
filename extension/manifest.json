{
  "manifest_version": 3,
  "name": "Levent 115 离线助手",
  "version": "1.1.0",
  "author": "LeventLei",
  "description": "批量识别 magnet/ed2k 链接并安全推送到 115，支持目录选择和广告词清理。",
  "permissions": [
    "storage",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "https://*.115.com/*",
    "https://115.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "115 Offline Helper",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
